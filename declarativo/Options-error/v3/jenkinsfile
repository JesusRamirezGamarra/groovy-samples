pipeline {
    agent any
    options {
        timeout(time: 1, unit: 'MINUTES') // Timeout global
    }
  
    stages {
        stage('Inicio de options') {
            steps {
                echo "El pipeline ejecuta una tarea con un timeout de 1 minuto"
            }
        }
        stage('Tarea por tiempo') {
            steps {
                echo "Empezando simulación de tarea larga..."
                catchError(buildResult: 'ABORTED', stageResult: 'ABORTED') {
                    echo 'Empezando la actividad de error...'
                    sleep(time: 2, unit: 'MINUTES') // Esto generará un timeout
                }
            }
        }

        stage('Finalizando') {
            steps {
                echo "Tarea procesada..."
            }
        }
    }

    post {
        always {
            script {
                if (currentBuild.result == 'ABORTED') {
                    currentBuild.result = 'FAILURE' // Cambia a estado FALLIDO
                    echo 'ESTADO CAMBIADO A FALLIDO'
                }
            }
        }

        failure {
            echo 'PIPELINE SETEADO CON UN ESTADO FALLIDO DEBIDO AL TIMEOUT'
        }
    }
}
