pipeline{
    agent any

    stages{
        stage('Tareas en paralelo'){
            parallel{
                stage('Compilar proyecto JAVA'){
                    agent{
                        docker{
                            image 'maven:3.8.4-jdk-11'
                            args '-p 3000:3000'
                        }
                    }
                    steps{
                        sh 'mvn clean install'
                    }
                }
                stage('Compilar proyecto JAVA 2'){
                    agent{
                        docker{
                            image 'maven:3.8.4-jdk-11'
                            args '-p 3000:3000'
                        }
                    }
                    steps{
                        sh 'mvn clean install'
                    }
                }
            }
        }
    }
}